# Generic Stuff
APP_NAME="watr.lol"
APP_DESC="one account for every watr thing"
APP_URL="http://localhost:8080"   # no trailing slash. https:// turns on secure cookies
APP_ENV=local
APP_DEBUG=true

# signs cookies. make one with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=""

# yellow strip under the bar. leave empty for none
SITE_NOTICE=""
REGISTRATION_OPEN=true

# Cookies
AUTH_COOKIE="watr_session"
COOKIE_DOMAIN=""                  # leave empty unless you know you want it shared
TRUST_CLOUDFLARE=false            # read the visitor ip from CF-Connecting-IP

# Database
DB_DRIVER=mysql                   # mysql or sqlite
DB_HOST="127.0.0.1"
DB_NAME="watrlol"
DB_USER=""
DB_PASS=""
DB_PATH="storage/watr.sqlite"     # sqlite only

# Mail (password resets, confirming emails, security notices)
# works with any smtp login. for zoho mail:
#   MAIL_HOST   smtp.zoho.com, or smtp.zoho.eu / smtp.zoho.in / smtp.zoho.com.au for your region.
#               paid zoho mail with your own domain uses smtppro.zoho.com (or smtppro.zoho.eu...)
#   MAIL_PORT   465 with ssl, or 587 with tls. both get past an isp that blocks port 25
#   MAIL_PASSWORD  your zoho password, or an app-specific password if you use 2fa (you probably do)
#   MAIL_FROM   has to be the zoho mailbox you log in with, or an alias you added to it
# leave MAIL_HOST empty and emails get written to storage/mail.log instead
MAIL_HOST=""
MAIL_PORT=465
MAIL_ENCRYPTION=ssl               # ssl for 465, tls for 587
MAIL_USERNAME=""                  # the full address, like noreply@watr.lol
MAIL_PASSWORD=""
MAIL_FROM=""                      # empty = same as MAIL_USERNAME
MAIL_FROM_NAME="watr.lol"

# Logging
LOG_WEBHOOK=""                    # discord webhook for site errors

# Sign in with... (each one turns on when its id and secret are set)
# callback url to register with the provider: APP_URL/auth/callback/<provider>
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# any other oauth2 / openid connect provider (another watr.lol, authentik, keycloak...)
OAUTH_NAME=""                     # shown on the button
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_AUTHORIZE_URL=""
OAUTH_TOKEN_URL=""
OAUTH_USERINFO_URL=""
OAUTH_SCOPES="openid profile"
OAUTH_ID_FIELD="sub"              # which userinfo field is the user id
OAUTH_USERNAME_FIELD="preferred_username"
