{% extends "models/app.twig" %}
{% block pageName %}Edit {{ category.name }}{% endblock %}
{% block body %}
{% include 'admin/tabs.twig' %}

<h2>Edit {{ category.name }}</h2>
<form method="post" action="/admin/categories/{{ category.id }}" class="watr-stack form measure">
    {{ csrf_field() }}
    {% if error is defined %}<div class="watr-msg full" role="alert">{{ error }}</div>{% endif %}
    <label class="field-label" for="name">name</label>
    <input type="text" name="name" id="name" class="full" maxlength="60" value="{{ category.name }}" required>
    <label class="field-label" for="slug">url name</label>
    <input type="text" name="slug" id="slug" class="full" maxlength="40" pattern="[a-z0-9\-]+" value="{{ category.slug }}" required>
    <p class="hint">Changing it breaks old links to /forum/{{ category.slug }}.</p>
    <label class="field-label" for="description">description</label>
    <input type="text" name="description" id="description" class="full" maxlength="255" value="{{ category.description }}">
    <label class="watr-check"><input type="checkbox" name="staff_only" value="1"{% if category.staff_only %} checked{% endif %}> only staff can start threads</label>
    <div class="watr-row">
        <a class="watr-btn watr-btn--quiet" href="/admin/categories">Cancel</a>
        <button type="submit" class="watr-btn">Save category</button>
    </div>
</form>
{% endblock %}
