{% extends "models/app.twig" %}
{% block pageName %}Edit {{ project.name }}{% endblock %}
{% block body %}
{% include 'admin/tabs.twig' %}

<h2>Edit {{ project.name }}</h2>
<form method="post" action="/admin/projects/{{ project.id }}" class="watr-stack form measure">
    {{ csrf_field() }}
    {% if error is defined %}<div class="watr-msg full" role="alert">{{ error }}</div>{% endif %}
    <label class="field-label" for="name">name</label>
    <input type="text" name="name" id="name" class="full" maxlength="60" value="{{ project.name }}" required>
    <label class="field-label" for="description">description</label>
    <input type="text" name="description" id="description" class="full" maxlength="255" value="{{ project.description }}">
    <label class="field-label" for="url">link</label>
    <input type="url" name="url" id="url" class="full" maxlength="255" value="{{ project.url }}" placeholder="https://">
    <label class="watr-check"><input type="checkbox" name="active" value="1"{% if project.active %} checked{% endif %}> show it on /projects</label>
    <div class="watr-row">
        <a class="watr-btn watr-btn--quiet" href="/admin/projects">Cancel</a>
        <button type="submit" class="watr-btn">Save project</button>
    </div>
</form>
{% endblock %}
