{% extends "models/plain.twig" %}
{% block pageName %}Pick a username{% endblock %}
{% block body %}
<div class="watr-split auth">
    <div class="watr-split__aside">
        <h1>Almost done</h1>
        <p class="lede">You're signing up with {{ provider }} as <b>{{ identity.display ?: identity.username }}</b>.</p>
        <p class="muted">Pick what people see here. You can add a password later in settings.</p>
    </div>
    <div class="watr-split__main auth__main">
        {% if error is defined %}<div class="watr-msg" role="alert">{{ error }}</div>{% endif %}
        <form method="post" action="/auth/finish" class="watr-stack auth__form">
            {{ csrf_field() }}
            <label class="sr-only" for="username">username</label>
            <input type="text" name="username" id="username" placeholder="username" value="{{ username }}" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="20" pattern="[A-Za-z0-9_.\-]+" required autofocus>
            <p class="hint">3 to 20 letters, numbers, dots, dashes or underscores.</p>
            <button type="submit" class="watr-btn auth__submit">Create account</button>
        </form>
    </div>
</div>
{% endblock %}
