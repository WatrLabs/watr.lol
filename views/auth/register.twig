{% extends "models/plain.twig" %}
{% block pageName %}Sign up{% endblock %}
{% block body %}
<div class="watr-split auth">
    <div class="watr-split__aside">
        {% include 'snippets/auth_logo.twig' %}
        <h1>Sign up</h1>
        <p class="muted auth__tag">One account for every watr thing.</p>
    </div>
    <div class="watr-split__main auth__main">
        {% if env('REGISTRATION_OPEN', 'true') != 'true' %}
            <div class="watr-msg watr-msg--warning">Sign ups are closed right now. If you already have an account, <a href="/auth/login">log in</a>.</div>
        {% else %}
            {% if error is defined %}<div class="watr-msg" role="alert">{{ error }}</div>{% endif %}
            <form method="post" action="/auth/register" class="watr-stack auth__form">
                {{ csrf_field() }}
                <input type="hidden" name="continue" value="{{ continue }}">
                <label class="sr-only" for="username">username</label>
                <input type="text" name="username" id="username" placeholder="username" value="{{ username ?? '' }}" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="20" pattern="[A-Za-z0-9_.\-]+" required autofocus>
                <label class="sr-only" for="email">email (optional)</label>
                <input type="email" name="email" id="email" placeholder="email (optional)" value="{{ email ?? '' }}" maxlength="254" autocomplete="email">
                <label class="sr-only" for="password">password</label>
                <input type="password" name="password" id="password" placeholder="password" autocomplete="new-password" minlength="8" required>
                <label class="sr-only" for="password_confirm">password again</label>
                <input type="password" name="password_confirm" id="password_confirm" placeholder="password again" autocomplete="new-password" minlength="8" required>
                <p class="hint">3 to 20 letters, numbers, dots, dashes or underscores. Passwords need 8 characters. An email lets you reset your password.</p>
                <button type="submit" class="watr-btn auth__submit">Sign up</button>
            </form>
            {% include 'snippets/providers.twig' with {verb: 'sign up'} %}
        {% endif %}
        <p class="auth__switch">Have an account? <a href="/auth/login{% if continue != '/' %}?continue={{ continue|url_encode }}{% endif %}">Log in</a></p>
    </div>
</div>
{% endblock %}
