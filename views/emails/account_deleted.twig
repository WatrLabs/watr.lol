{% extends "emails/layout.twig" %}
{% block html %}
<h1 style="margin:0 0 12px;font-size:22px;font-weight:800;">Your account was deleted</h1>
<p style="margin:0;">The account <b>@{{ user.username }}</b> was deleted from {{ ip }}, along with its logins, linked accounts and apps. This is the last email we'll send to this address.</p>
<p style="margin:14px 0 0;">Thanks for being here. You're welcome back any time.</p>
{% endblock %}
{% block text %}
The account @{{ user.username }} on {{ app_name }} was deleted from {{ ip }}, along with its logins, linked accounts and apps. This is the last email we'll send to this address.

Thanks for being here. You're welcome back any time.
{% endblock %}
