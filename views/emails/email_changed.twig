{% extends "emails/layout.twig" %}
{% block html %}
<h1 style="margin:0 0 12px;font-size:22px;font-weight:800;">Your email was changed</h1>
<p style="margin:0;">The email on <b>@{{ user.username }}</b> is now <b>{{ new_email }}</b>, so this address won't get password resets anymore.</p>
<p style="margin:14px 0 0;">If you didn't do this, someone else may be in your account. Reply to this email or contact an admin on <a href="{{ app_url }}" style="color:#17506f;">{{ app_name }}</a>.</p>
{% endblock %}
{% block text %}
The email on @{{ user.username }} ({{ app_name }}) is now {{ new_email }}, so this address won't get password resets anymore.

If you didn't do this, someone else may be in your account. Reply to this email or contact an admin on {{ app_url }}.
{% endblock %}
