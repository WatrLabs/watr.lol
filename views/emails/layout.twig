{# html email. inline styles and tables, because email clients. colors are the blue ramp (hue 237) as hex #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f4f6;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f4f6;">
<tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background-color:#ffffff;box-shadow:5px 5px 5px rgba(15,15,15,0.25);">
        <tr><td style="background-color:#3f95c6;padding:13px 20px;font-family:Montserrat,'Segoe UI',Arial,sans-serif;font-weight:700;font-size:16px;color:#ffffff;">
            <a href="{{ app_url }}" style="color:#ffffff;text-decoration:none;">{{ app_name }}</a>
        </td></tr>
        <tr><td style="padding:28px 24px 24px;font-family:Montserrat,'Segoe UI',Arial,sans-serif;font-size:15px;line-height:1.55;color:#080e12;">
            {% block html %}{% endblock %}
        </td></tr>
        <tr><td style="padding:14px 24px;background-color:#e3f7ff;font-family:Montserrat,'Segoe UI',Arial,sans-serif;font-size:12px;line-height:1.5;color:#474e53;">
            You got this because of your account on <a href="{{ app_url }}" style="color:#474e53;">{{ app_name }}</a>.
        </td></tr>
    </table>
</td></tr>
</table>
</body>
</html>
