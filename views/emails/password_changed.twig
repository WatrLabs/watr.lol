{% extends "emails/layout.twig" %}
{% block html %}
<h1 style="margin:0 0 12px;font-size:22px;font-weight:800;">Your password was changed</h1>
<p style="margin:0;">The password for <b>@{{ user.username }}</b> just changed, from {{ ip }}. Every other device was logged out.</p>
<p style="margin:14px 0 0;">If that was you, you're all set. If it wasn't, reset it right away:</p>
{% include "emails/button.twig" with {label: 'Reset password'} %}
{% endblock %}
{% block text %}
The password for @{{ user.username }} on {{ app_name }} just changed, from {{ ip }}. Every other device was logged out.

If that was you, you're all set. If it wasn't, reset it right away:
{{ link }}
{% endblock %}
