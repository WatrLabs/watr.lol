{% extends "models/app.twig" %}
{% set active_category = thread.category.slug ?? null %}
{% block pageName %}Edit post{% endblock %}
{% block body %}
<ol class="watr-crumbs">
    <li><a href="/forum">forum</a></li>
    {% if thread.category %}<li><a href="/forum/{{ thread.category.slug }}">{{ thread.category.name|lower }}</a></li>{% endif %}
    <li><a href="/forum/t/{{ thread.id }}">thread</a></li>
    <li aria-current="page">edit</li>
</ol>

<h1>Edit post</h1>

<form method="post" action="/forum/p/{{ post.id }}/edit" class="watr-stack editor measure-wide">
    {{ csrf_field() }}
    {% if error is defined %}<div class="watr-msg full" role="alert">{{ error }}</div>{% endif %}
    {% if is_first %}
        <label class="field-label" for="title">title</label>
        <input type="text" name="title" id="title" class="full" maxlength="120" value="{{ title }}" required>
    {% endif %}
    <label class="field-label" for="body">post</label>
    <textarea name="body" id="body" rows="12" maxlength="10000" required autofocus>{{ body }}</textarea>
    <div class="editor__foot">
        {% include 'snippets/format_help.twig' %}
        <div class="watr-row">
            <a class="watr-btn watr-btn--quiet" href="/forum/p/{{ post.id }}">Cancel</a>
            <button type="submit" class="watr-btn">Save changes</button>
        </div>
    </div>
</form>
{% endblock %}
