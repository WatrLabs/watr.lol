{% extends "models/app.twig" %}
{% import "snippets/macros.twig" as m %}
{% block pageName %}Home{% endblock %}
{% block body %}
<div class="home">
    <h1>Hey, {{ currentuser.display_name ?: currentuser.username }}</h1>

    {% if not currentuser.email %}
        <div class="watr-msg watr-msg--info">Add an email so you can reset your password if you forget it. <a href="/settings/email">Add email</a></div>
    {% endif %}

    <section class="home-latest">
        <h2>Latest on the forum</h2>
        {% if recent %}
            {% include 'snippets/thread_list.twig' with {threads: recent} %}
            <a href="/forum" class="more-link">See the forum</a>
        {% else %}
            {{ m.empty('Nothing here yet', 'Nobody has posted. Pick a category and start a thread.', 2) }}
        {% endif %}
    </section>

    {% if apps %}
    <p class="muted small">You sign in to {{ apps|map(a => a.app_name)|join(', ', ' and ') }} with {{ env('APP_NAME') }}. <a href="/settings/apps">Manage</a></p>
    {% endif %}
</div>
{% endblock %}
