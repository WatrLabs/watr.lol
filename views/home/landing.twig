{% extends "models/plain.twig" %}
{% block pageName %}One account for every watr thing{% endblock %}
{% block pageClass %}landing{% endblock %}
{% block body %}
<section class="watr-split hero">
    <div class="watr-split__aside">
        <picture>
            <source srcset="/assets/images/logos/watrlabs-logo-dark.svg" media="(prefers-color-scheme: dark)">
            <img class="hero__logo" src="/assets/images/logos/watrlabs-logo.svg" alt="watrLabs" width="283" height="80">
        </picture>
        <h1>One account for every watr thing.</h1>
        <p class="lede">Sign up once, then use it on every watrlabs site. <a href="/projects">See what's running</a>.</p>
    </div>
    <div class="watr-split__main watr-stack hero__actions">
        <a class="watr-btn" href="/auth/register">Make an account</a>
        <a class="watr-btn watr-btn--quiet" href="/auth/login">Log in</a>
    </div>
</section>

{% if recent %}
<section class="home-latest">
    <h2>Latest on the forum</h2>
    {% include 'snippets/thread_list.twig' with {threads: recent|slice(0, 5)} %}
    <a href="/forum" class="more-link">See the forum</a>
</section>
{% endif %}
{% endblock %}
