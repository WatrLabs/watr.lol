<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block description %}{{ env('APP_DESC') }}{% endblock %}">
    <title>{% block pageName %}{% endblock %} - {{ env('APP_NAME') }}</title>
    <link rel="icon" href="/assets/images/logos/WatrLabsIcon.png">
    <link rel="stylesheet" href="/assets/watr/watr.css?v=0.5">
    <link rel="stylesheet" href="/assets/site.css?v=4">
    {% block headerGoodies %}{% endblock %}
  </head>
  <body>
    {% include 'snippets/header.twig' %}
    {% block page %}{% endblock %}
    {% include 'snippets/footer.twig' %}
  </body>
</html>
