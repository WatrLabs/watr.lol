{% extends "models/plain.twig" %}
{% block pageName %}Can't sign you in{% endblock %}
{% block body %}
<div class="watr-blob">
    <div>
        <h1>Can't sign you in</h1>
        <p>{{ message }}</p>
        <div class="watr-row">
            <a class="watr-btn" href="#" data-back>Go back</a>
