{% extends "models/app.twig" %}
{% block pageName %}Password{% endblock %}
{% block body %}
{% include 'settings/tabs.twig' %}

<form method="post" action="/settings/password" class="watr-stack form measure">
    {{ csrf_field() }}
    {% if error is defined %}<div class="watr-msg full" role="alert">{{ error }}</div>{% endif %}

    {% if user.password %}
        <label class="field-label" for="current">current password</label>
        <input type="password" name="current" id="current" class="full" autocomplete="current-password" required>
    {% else %}
        <div class="watr-msg watr-msg--info full">You don't have a password yet, you sign in with a linked account. Set one to log in with your username too.</div>
    {% endif %}

    <label class="field-label" for="password">new password</label>
    <input type="password" name="password" id="password" class="full" autocomplete="new-password" minlength="8" required>

    <label class="field-label" for="password_confirm">new password again</label>
    <input type="password" name="password_confirm" id="password_confirm" class="full" autocomplete="new-password" minlength="8" required>

    <p class="hint">At least 8 characters. Changing it logs out your other devices.</p>
    <button type="submit" class="watr-btn">{{ user.password ? 'Change password' : 'Set password' }}</button>
</form>
{% endblock %}
