{% extends "models/app.twig" %}
{% import "snippets/macros.twig" as m %}
{% block pageName %}Settings{% endblock %}
{% block body %}
{% include 'settings/tabs.twig' %}

<form method="post" action="/settings" class="watr-stack form measure">
    {{ csrf_field() }}
    {% if error is defined %}<div class="watr-msg full" role="alert">{{ error }}</div>{% endif %}

    <div class="profile profile--small">
        {{ m.avatar(user, 'big') }}
        <p class="muted">Your picture is a blob, picked by your account number. Everyone gets one.</p>
    </div>

    <label class="field-label" for="username">username</label>
    <input type="text" name="username" id="username" class="full" value="{{ user.username }}" minlength="3" maxlength="20" pattern="[A-Za-z0-9_.\-]+" autocapitalize="none" spellcheck="false" required>
    <p class="hint">Changing it changes your profile link. Sites you signed in to keep knowing it's you.</p>

    <label class="field-label" for="display_name">display name</label>
    <input type="text" name="display_name" id="display_name" class="full" value="{{ user.display_name }}" maxlength="40" placeholder="{{ user.username }}">

    <label class="field-label" for="pronouns">pronouns</label>
    <input type="text" name="pronouns" id="pronouns" class="full" value="{{ user.pronouns }}" maxlength="30" placeholder="they/them">

    <label class="field-label" for="bio">bio</label>
    <textarea name="bio" id="bio" class="full" rows="4" maxlength="500">{{ user.bio }}</textarea>

    <label class="field-label" for="location">location</label>
    <input type="text" name="location" id="location" class="full" value="{{ user.location }}" maxlength="60" placeholder="the internet">

    <label class="field-label" for="website">website</label>
    <input type="url" name="website" id="website" class="full" value="{{ user.website }}" maxlength="255" placeholder="https://" autocapitalize="none" spellcheck="false">
    <p class="hint">All of these show on your profile, and are optional.</p>

    <button type="submit" class="watr-btn">Save profile</button>
</form>
{% endblock %}
