{% extends "models/app.twig" %}
{% import "snippets/macros.twig" as m %}
{% block pageName %}Devices{% endblock %}
{% block body %}
{% include 'settings/tabs.twig' %}

<div class="page__head measure-wide">
    <p class="muted">Everywhere you're logged in to {{ env('APP_NAME') }}.</p>
    {% if sessions|length > 1 %}
        {{ m.action('/settings/sessions/revoke-others', 'Log out everywhere else', {confirm: 'Every other device gets logged out. This one stays logged in.', title: 'log out other devices', button: 'Log them out'}) }}
    {% endif %}
</div>

<div class="watr-table-wrap measure-wide">
    <table class="watr-table watr-table--stack">
        <thead><tr><th>device</th><th>ip</th><th>last active</th><th></th></tr></thead>
        <tbody>
        {% for s in sessions %}
            <tr>
                <td class="is-main">
                    {{ s.user_agent|length > 70 ? s.user_agent|slice(0, 70) ~ '…' : s.user_agent }}
                    {% if current and s.id == current.id %}<span class="watr-tag watr-tag--bright">this one</span>{% endif %}
                </td>
                <td class="muted">{{ s.ip }}</td>
                <td class="muted">{{ s.last_seen|ago }}</td>
                <td class="num">
                    {% if not (current and s.id == current.id) %}
                        {{ m.action('/settings/sessions/' ~ s.id ~ '/revoke', 'Log out') }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
