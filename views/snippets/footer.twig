<footer class="watr-footer watr-footer--cols">
    <div class="watr-footer__cols">
        <div class="watr-footer__brand">
            <a href="/"><span class="watr-mark"><img src="/assets/images/logos/watrlabs-mark-dark.svg" alt="" width="24" height="24"></span>{{ env('APP_NAME') }}</a>
            <p>{{ env('APP_DESC') }}.</p>
        </div>
        <nav aria-label="explore">
            <h2>explore</h2>
            <a href="/forum">forum</a>
            <a href="/people">people</a>
            <a href="/projects">projects</a>
        </nav>
        <nav aria-label="your account">
            <h2>account</h2>
            {% if currentuser %}
                <a href="/u/{{ currentuser.username }}">profile</a>
                <a href="/settings">settings</a>
                <a href="/notifications">notifications</a>
            {% else %}
                <a href="/auth/login">log in</a>
                <a href="/auth/register">sign up</a>
                <a href="/auth/forgot">forgot password</a>
            {% endif %}
        </nav>
        <nav aria-label="developers">
            <h2>developers</h2>
            <a href="/developers">your apps</a>
            <a href="/developers/docs">docs</a>
        </nav>
    </div>
    <div class="watr-footer__base">&copy; {{ "now"|date("Y") }} watrLabs</div>
</footer>

{# one shared "are you sure?" dialog. site.js fills it in from the form's data-confirm #}
<dialog class="watr-dialog watr-dialog--danger" id="confirm">
    <form method="dialog">
        <div class="watr-dialog__head"><h2 id="confirm-title">are you sure?</h2><button type="button" class="watr-dialog__close" data-watr-close aria-label="close">&times;</button></div>
        <div class="watr-dialog__body"><p id="confirm-text"></p></div>
        <div class="watr-dialog__foot">
            <button type="button" class="watr-btn watr-btn--quiet" data-watr-close>Cancel</button>
            <button class="watr-btn watr-btn--danger" value="yes" id="confirm-button">Delete</button>
        </div>
    </form>
</dialog>

{% set note = flash() %}
{% if note %}<div id="flash" hidden data-message="{{ note.message }}" data-type="{{ note.type }}"></div>{% endif %}

<script src="/assets/watr/watr.js?v=0.5"></script>
<script src="/assets/site.js?v=2"></script>
