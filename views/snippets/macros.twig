{# little bits used everywhere. import with: {% import "snippets/macros.twig" as m %} #}

{# a google blob emoji, picked from the user id so it never changes #}
{% macro avatar(user, size) %}
{% set px = {small: 28, big: 120}[size] ?? 48 %}
<img class="blob-avatar{% if size %} blob-avatar--{{ size }}{% endif %}" src="{{ blob_avatar(user) }}" alt="" width="{{ px }}" height="{{ px }}">
{% endmacro %}

{% macro name(user) %}
{%- if user -%}
<a href="/u/{{ user.username }}" class="person">{{ user.display_name ?: user.username }}</a>
{%- else -%}
<span class="person muted">deleted</span>
{%- endif -%}
{% endmacro %}

{% macro role_tag(user) %}
{%- if user and user.banned -%}<span class="watr-tag watr-tag--danger">banned</span>
{%- elseif user and user.role == 'admin' -%}<span class="watr-tag watr-tag--bright">admin</span>
{%- elseif user and user.role == 'mod' -%}<span class="watr-tag watr-tag--deep">mod</span>
{%- endif -%}
{% endmacro %}

{# page numbers. shows the first, the last, and two either side of where you are #}
{% macro pages(pager, base) %}
{% if pager.pages > 1 %}
{% set glue = '?' in base ? '&' : '?' %}
<nav class="watr-pages" aria-label="pages">
    {% if pager.page > 1 %}<a href="{{ base }}{{ glue }}page={{ pager.page - 1 }}" aria-label="previous page">&lsaquo;</a>{% endif %}
    {% set shown_gap = false %}
    {% for p in 1..pager.pages %}
        {% if p == 1 or p == pager.pages or (p >= pager.page - 2 and p <= pager.page + 2) %}
            {% if p == pager.page %}<span aria-current="page">{{ p }}</span>{% else %}<a href="{{ base }}{{ glue }}page={{ p }}">{{ p }}</a>{% endif %}
            {% set shown_gap = false %}
        {% elseif not shown_gap %}
            <span class="is-gap">&hellip;</span>
            {% set shown_gap = true %}
        {% endif %}
    {% endfor %}
    {% if pager.page < pager.pages %}<a href="{{ base }}{{ glue }}page={{ pager.page + 1 }}" aria-label="next page">&rsaquo;</a>{% endif %}
</nav>
{% endif %}
{% endmacro %}

{# a one-button form. data-confirm makes site.js ask first, using the danger dialog #}
{% macro action(url, label, opts) %}
<form method="post" action="{{ url }}" class="inline-form"{% if opts.confirm is defined %} data-confirm="{{ opts.confirm }}" data-confirm-title="{{ opts.title ?? 'are you sure?' }}" data-confirm-button="{{ opts.button ?? label }}"{% endif %}>
    {{ csrf_field() }}
    {% for key, value in opts.fields ?? {} %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
    <button type="submit" class="{{ opts.class ?? 'watr-btn watr-btn--quiet' }}">{{ label }}</button>
</form>
{% endmacro %}

{# empty states get a blob, same as errors do. mood: sleepy, meh, upside or hug #}
{% macro empty(title, text, mood) %}
{% set faces = {sleepy: '1f634', meh: '1f610', upside: '1f643', hug: '1f917'} %}
<div class="watr-blob empty">
    <div>
        <h2>{{ title }}</h2>
        <p>{{ text }}</p>
    </div>
    <img class="empty__face" src="/assets/images/blobs/u{{ faces[mood] ?? '1f610' }}.png" alt="" width="120" height="120">
</div>
{% endmacro %}

{# blob reactions under a post or update. one form, each emoji is its own submit button.
   site.js sends it in the background and redraws the counts. summary comes from reactions::summarize #}
{% macro reactions(target, id, summary, back) %}
<form method="post" action="/react" class="reacts" data-react>
    {{ csrf_field() }}
    <input type="hidden" name="target" value="{{ target }}">
    <input type="hidden" name="id" value="{{ id }}">
    <input type="hidden" name="continue" value="{{ back }}">
    {% for emoji, r in summary %}
        <button type="submit" name="emoji" value="{{ emoji }}" class="react{% if r.mine %} is-mine{% endif %}" aria-pressed="{{ r.mine ? 'true' : 'false' }}" title="{{ emoji }}"{% if not currentuser %} disabled{% endif %}><img src="{{ reaction_image(emoji) }}" alt="{{ emoji }}" width="20" height="20"><span>{{ r.count }}</span></button>
    {% endfor %}
    {% if currentuser %}
    <details class="watr-dropdown react-pick">
        <summary class="react react--add" aria-label="add a reaction" title="react">+</summary>
        <div class="watr-menu react-menu">
            {% for emoji in reaction_emoji() %}<button type="submit" name="emoji" value="{{ emoji }}" title="{{ emoji }}"><img src="{{ reaction_image(emoji) }}" alt="{{ emoji }}" width="28" height="28"></button>{% endfor %}
        </div>
    </details>
    {% endif %}
</form>
{% endmacro %}

{# follow / unfollow, or nothing when it's you or you're logged out #}
{% macro follow_button(person, following, back) %}
{% if currentuser and currentuser.id != person.id %}
<form method="post" action="/u/{{ person.username }}/{{ following ? 'unfollow' : 'follow' }}" class="inline-form">
    {{ csrf_field() }}
    <input type="hidden" name="continue" value="{{ back }}">
    <button type="submit" class="watr-btn{% if following %} watr-btn--quiet{% endif %}">{{ following ? 'Following' : 'Follow' }}</button>
</form>
{% endif %}
{% endmacro %}

{# a person in a list: blob, name, @handle, and a follow button #}
{% macro person_row(person, following, back) %}
{% import _self as m %}
<li class="person-row">
    <a href="/u/{{ person.username }}" class="person-row__pic">{{ m.avatar(person) }}</a>
    <div class="person-row__text">
        {{ m.name(person) }} {{ m.role_tag(person) }}
        <small class="muted">@{{ person.username }}{% if person.pronouns %} &middot; {{ person.pronouns }}{% endif %}</small>
        {% if person.bio %}<small class="person-row__bio">{{ person.bio|length > 120 ? person.bio|slice(0, 120) ~ '…' : person.bio }}</small>{% endif %}
    </div>
    {{ m.follow_button(person, following, back) }}
</li>
{% endmacro %}
