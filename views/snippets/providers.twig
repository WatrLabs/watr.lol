{# "or log in with discord" buttons. only shows the ones set up in .env #}
{% set providers = login_providers() %}
{% if providers %}
<div class="providers">
    <p class="providers__label">or {{ verb ?? 'log in' }} with</p>
    <div class="watr-row">
        {% for p in providers %}
        <form method="post" action="/auth/connect/{{ p.slug }}" class="inline-form">
            {{ csrf_field() }}
            <input type="hidden" name="continue" value="{{ continue ?? '/' }}">
            <button type="submit" class="watr-btn watr-btn--quiet">{{ p.name }}</button>
        </form>
        {% endfor %}
    </div>
</div>
{% endif %}
