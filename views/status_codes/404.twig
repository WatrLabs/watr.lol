{% extends "models/plain.twig" %}
{% block pageName %}Page Not Found{% endblock %}
{% block body %}
<div class="watr-blob">
    <div>
        <h1>404 - Page Not Found</h1>
        <p>{{ message ?? "Couldn't find this page. It might have moved, or never existed." }}</p>
        <div class="watr-row">
            <a class="watr-btn" href="#" data-back>Go back</a>
            <a class="watr-btn watr-btn--quiet" href="/">Go home</a>
        </div>
    </div>
    <img class="watr-blob__face" src="/assets/images/blobs/thinking.png" alt="Thinking face emoji" width="180" height="180">
</div>
{% endblock %}
